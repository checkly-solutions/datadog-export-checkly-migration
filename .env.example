# Datadog API Credentials
# Get these from: https://app.datadoghq.com/organization-settings/api-keys

# Required: Your Datadog API key
DD_API_KEY=your_api_key_here

# Required: Your Datadog Application key
# Create at: https://app.datadoghq.com/organization-settings/application-keys
# Requires scopes: synthetics_read, monitors_read, synthetics_global_variable_read, synthetics_private_location_read
DD_APP_KEY=your_app_key_here

# Optional: Datadog site/region (defaults to US1)
# US1 (default): datadoghq.com
# US3:           us3.datadoghq.com
# US5:           us5.datadoghq.com
# EU1:           datadoghq.eu
# AP1:           ap1.datadoghq.com
# US1-FED:       ddog-gov.com
DD_SITE=datadoghq.com

# Optional: Check Datadog test status and deactivate failing tests during migration
# Set to "true" to enable. Requires DD_API_KEY and DD_APP_KEY.
DD_CHECK_STATUS=true

# Optional: Only export tests matching these Datadog tags (comma-separated, OR logic)
# Tag matching is case-insensitive. When unset or empty, all tests are exported.
# Example: DD_TAGS_TO_MIGRATE=env:prod,NCP
DD_TAGS_TO_MIGRATE=prod

# Checkly API Credentials (for importing environment variables)
# Get these from: https://app.checklyhq.com/settings/account/api-keys

# Required for variable import: Your Checkly API key
CHECKLY_API_KEY=your_checkly_api_key_here

# Required for variable import: Your Checkly Account ID
# Found at: https://app.checklyhq.com/settings/account/general
CHECKLY_ACCOUNT_ID=your_checkly_account_id_here

# Account name for migration output directory
# Output goes to: checkly-migrated/<account-name>/
CHECKLY_ACCOUNT_NAME=acme

# Optional: write TCP synthetics (Datadog subtype:'tcp' → Checkly TcpMonitor) to a
# separate standalone Checkly project at checkly-migrated/<slug>/ instead of
# inlining them into the main migration project. Useful when you want to deploy
# TCP monitors as an isolated Checkly project. When unset, TCP files land in
# <account-name>/__checks__/tcp/ alongside the rest of the migration.
# Example: CHECKLY_TCP_PROJECT_NAME=acme-tcp
# CHECKLY_TCP_PROJECT_NAME=

# Optional: same idea as CHECKLY_TCP_PROJECT_NAME, but for DNS monitors
# (Datadog subtype:'dns' → Checkly DnsMonitor via step 04c).
# Example: CHECKLY_DNS_PROJECT_NAME=acme-dns
# CHECKLY_DNS_PROJECT_NAME=
