    "assertions": [
      { "type": "statusCode", "operator": "is", "target": 200 },
      { "type": "body", "operator": "contains", "target": "ok" }
    ]
  },
  "options": {
    "tick_every": 300,
    "retry": { "count": 1, "interval": 300 },
    "monitor_priority": 3
  },
  "message": "Unit baseline alert",
  "monitor_id": 2101
}
