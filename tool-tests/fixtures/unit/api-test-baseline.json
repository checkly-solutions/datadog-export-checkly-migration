{
  "public_id": "syn-101-abc",
  "name": "Unit API Baseline",
  "type": "api",
  "subtype": "http",
  "status": "live",
  "tags": ["env:synthetic", "team:example"],
  "locations": ["us-east-1"],
  "privateLocations": [],
  "originalLocations": ["aws:us-east-1"],
